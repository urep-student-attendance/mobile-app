{
  "name": "urep-mobile-app",
  "version": "0.1.0",
  "private": true,
  "description": "Student attendance app for the UREP PALM reader project, previewed as a web app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
